#!/bin/bash

# Rockchip tweaks for the suites built from the official livecd-rootfs of
# the target Ubuntu release (KERNEL_TYPE="mainline"). This is the mainline
# counterpart of the hook carried by the Joshua-Riek/livecd-rootfs fork.

set -ex

# shellcheck source=/dev/null
. /root/config/chroot

# Disable terminal ads
if command -v pro > /dev/null; then
    pro config set apt_news=false
fi

# Disable apport bug reporting
if [ -f /etc/default/apport ]; then
    sed -i 's/enabled=1/enabled=0/g' /etc/default/apport
fi

# Remove release upgrade motd
rm -f /var/lib/ubuntu-release-upgrader/release-upgrade-available
if [ -f /etc/update-manager/release-upgrades ]; then
    sed -i 's/Prompt=.*/Prompt=never/g' /etc/update-manager/release-upgrades
fi

# Let systemd create machine id on first boot
rm -f /var/lib/dbus/machine-id
true > /etc/machine-id

# U-Boot loads the kernel through extlinux, grub is not used
rm -rf /boot/grub

# Disable motd news
if [ -f /etc/default/motd-news ]; then
    sed -i 's/ENABLED=1/ENABLED=0/g' /etc/default/motd-news
fi

# Add new users to the video group
sed -i 's/#EXTRA_GROUPS=.*/EXTRA_GROUPS="video"/g' /etc/adduser.conf
sed -i 's/#ADD_EXTRA_GROUPS=.*/ADD_EXTRA_GROUPS=1/g' /etc/adduser.conf

# Override u-boot-menu config, the board config can add its own fragment
# (device tree, overlays) in /etc/u-boot-menu/conf.d
mkdir -p /usr/share/u-boot-menu/conf.d
cat << 'EOF' > /usr/share/u-boot-menu/conf.d/ubuntu.conf
U_BOOT_PROMPT="1"
U_BOOT_PARAMETERS="$(cat /etc/kernel/cmdline)"
U_BOOT_TIMEOUT="20"
U_BOOT_FDT_DIR="/usr/lib/firmware/"
EOF

# dracut defaults to host-only initramfs images, which would be tailored to
# the build host instead of the board (no SD/eMMC/NVMe or PMIC drivers)
mkdir -p /etc/dracut.conf.d
cat << 'EOF' > /etc/dracut.conf.d/10-ubuntu-rockchip.conf
hostonly="no"
hostonly_cmdline="no"
EOF

# Default kernel command line arguments
echo -n "rootwait rw console=ttyS2,1500000 console=tty1" > /etc/kernel/cmdline

if [ "$SUBPROJECT" == "desktop-preinstalled" ]; then
    # cloud-init would create a default user, which stops GNOME Initial
    # Setup from running and creating the first user on first boot
    apt-get -y purge cloud-init

    # Adjust kernel command line arguments for desktop
    echo -n " quiet splash plymouth.ignore-serial-consoles" >> /etc/kernel/cmdline
fi

# flash-kernel does not know Rockchip boards and would fail kernel upgrades
apt-get -y purge flash-kernel

# Update extlinux
u-boot-update
